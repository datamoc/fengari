{
  "name": "@datamoc/fengari",
  "version": "0.1.5",
  "description": "A Lua VM (latest version) written in JS ES6, targeting the browser and Node.js",
  "main": "src/fengari.js",
  "files": [
    "src/"
  ],
  "directories": {
    "lib": "src",
    "test": "test"
  },
  "scripts": {
    "lint": "eslint src/ test/",
    "prepublishOnly": "git diff-index --quiet --cached HEAD -- && npm run lint && npm run test && npm run build",
    "test": "jest",
    "test:extended": "jest test/lauxlib-extended.test.js",
    "build": "echo 'Build step for ESM and TypeScript definitions'",
    "prepack": "npm run build"
  },
  "keywords": [
    "lua",
    "lua5.5.1",
    "vm",
    "javascript",
    "webassembly",
    "embeddable",
    "scripting"
  ],
  "contributors": [
    "Benoit Giannangeli",
    "Daurnimator <quae@daurnimator.com>"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/datamoc/fengari.git"
  },
  "bugs": {
    "url": "https://github.com/datamoc/fengari/issues"
  },
  "homepage": "https://github.com/datamoc/fengari#readme",
  "devDependencies": {
    "eslint": "^9.39.2",
    "espree": "^10.4.0",
    "jest": "^30.2.0"
  },
  "dependencies": {
    "readline-sync": "^1.4.10",
    "sprintf-js": "^1.1.3",
    "tmp": "^0.2.5"
  },
  "sideEffects": false
}