{
  "name": "@datamoc/pyroeis",
  "version": "0.9.1",
  "description": "Pyroeis: a Lua 5.4.6 VM and Lua-to-JavaScript translator for browsers and Node.js",
  "main": "src/pyroeis.js",
  "types": "src/pyroeis.d.ts",
  "engines": {
    "node": ">=20"
  },
  "browser": {
    "fs": false,
    "os": false,
    "path": false,
    "crypto": false,
    "child_process": false
  },
  "bin": {
    "lua2js": "src/lua2js.js"
  },
  "files": [
    "src/",
    "logo.svg",
    "logo.png"
  ],
  "directories": {
    "lib": "src",
    "test": "test"
  },
  "scripts": {
    "lint": "eslint src/ test/",
    "prepublishOnly": "git diff-index --quiet --cached HEAD -- && npm run lint && npm run test && npm run build",
    "test": "jest",
    "test:extended": "jest test/lauxlib-extended.test.js",
    "bench:build": "node tools/build-benchmark.js",
    "build": "echo 'Build step for ESM and TypeScript definitions'",
    "prepack": "npm run build",
    "pages:build": "node tools/build-pages.js",
    "test:browsers": "node test/browsers/run.js"
  },
  "keywords": [
    "lua",
    "lua5.4",
    "vm",
    "javascript",
    "webassembly",
    "embeddable",
    "scripting"
  ],
  "contributors": [
    "Benoit Giannangeli",
    "Daurnimator <quae@daurnimator.com>"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/datamoc/pyroeis.git"
  },
  "bugs": {
    "url": "https://github.com/datamoc/pyroeis/issues"
  },
  "homepage": "https://datamoc.github.io/pyroeis/",
  "devDependencies": {
    "eslint": "^10.13.0",
    "espree": "^11.2.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "playwright-core": "^1.64.1"
  },
  "dependencies": {},
  "sideEffects": false
}
